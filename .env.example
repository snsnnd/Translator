# 复制为 .env 并填入你自己的 key (https://open.bigmodel.cn 免费注册)
# key 格式: id.secret, 支持多个: 越多并行吞吐越高 (见 docs/BYOK.md)

# key 支持自定义名称, 格式: API_KEY_<名称>=<key>
# 名称仅限 字母/数字/下划线, 例如:
API_KEY_main=你的第一个key
API_KEY_spare1=可选-第二个key
API_KEY_spare2=可选-第三个key

# 兼容旧格式 (编排器同样识别):
# ZHIPU_API_KEY=你的第一个key
# ZHIPU_API_KEY_2=可选-第二个key

# 不翻译的页码(如目录页), translate.sh 自动页探测时生效; parallel 用 --exclude
EXCLUDE_PAGES=
